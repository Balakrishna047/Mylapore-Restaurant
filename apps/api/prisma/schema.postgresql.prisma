generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  phone        String?
  role         String            @default("CUSTOMER")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  addresses    CustomerAddress[]
  orders       Order[]
  carts        Cart[]
  auditLogs    AuditLog[]
}

model CustomerAddress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street        String
  apt           String?
  city          String
  state         String
  zipCode       String
  deliveryNotes String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Restaurant {
  id                    String   @id @default(uuid())
  name                  String
  phone                 String
  email                 String
  address               String
  description           String
  openingTime           String   @default("11:00 AM")
  closingTime           String   @default("10:00 PM")
  minimumOrder          Float    @default(15.00)
  deliveryFee           Float    @default(4.99)
  freeDeliveryThreshold Float    @default(45.00)
  taxRate               Float    @default(0.0825)
  currency              String   @default("USD")
  isAcceptingOrders     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  icon         String
  description  String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  menuItems    MenuItem[]
}

model MenuItem {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  name                  String
  description           String
  categoryId            String
  category              MenuCategory      @relation(fields: [categoryId], references: [id])
  basePrice             Float
  image                 String
  orderCountBadge       String?
  isBlastChilled        Boolean           @default(true)
  dietaryTags           String
  spiceLevel            String            @default("MEDIUM")
  allergens             String
  ingredients           String
  nutritionServing      String            @default("1/2 cup (80 g)")
  reheatingInstructions String            @default("Refrigerate at <=40°F (4°C). Reheat thoroughly to 165°F before consuming.")
  isAvailable           Boolean           @default(true)
  rating                Float             @default(5.0)
  reviewCount           Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  variants              MenuItemVariant[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
}

model MenuItemVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  servesCount Int      @default(1)
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
}

model CartItem {
  id                  String   @id @default(uuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id])
  quantity            Int      @default(1)
  unitPrice           Float
  variantId           String?
  spiceLevel          String?
  specialInstructions String?
}

model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id])
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  status                String               @default("PENDING_PAYMENT")
  orderType             String               @default("DELIVERY")
  deliveryAddressText   String?
  deliverySlot          String
  subtotal              Float
  discount              Float                @default(0.0)
  tax                   Float                @default(0.0)
  deliveryFee           Float                @default(0.0)
  tip                   Float                @default(0.0)
  total                 Float
  paymentStatus         String               @default("REQUIRES_PAYMENT_METHOD")
  stripePaymentIntentId String?              @unique
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  items                 OrderItem[]
  history               OrderStatusHistory[]
  payments              Payment[]
  refunds               Refund[]
  supportTickets        SupportTicket[]
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  name           String
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  optionsSummary String?
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdBy String?  @default("SYSTEM")
  createdAt DateTime @default(now())
}

model Payment {
  id                    String   @id @default(uuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String   @unique
  amount                Float
  currency              String   @default("USD")
  status                String   @default("SUCCEEDED")
  paymentMethod         String   @default("CARD")
  rawEventId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  refunds               Refund[]
}

model Refund {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  stripeRefundId String?  @unique
  amount         Float
  reason         String
  status         String   @default("SUCCEEDED")
  createdAt      DateTime @default(now())
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String
  discountPercent Float?   @default(0)
  discountAmount  Float?   @default(0)
  minOrderAmount  Float    @default(20.00)
  maxDiscount     Float?
  validFrom       DateTime @default(now())
  validUntil      DateTime
  isActive        Boolean  @default(true)
  usageCount      Int      @default(0)
}

model SupportTicket {
  id               String   @id @default(uuid())
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id])
  customerName     String
  customerEmail    String
  customerPhone    String?
  subject          String
  description      String
  priority         String   @default("NORMAL")
  status           String   @default("OPEN")
  salesforceCaseId String?
  sentiment        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  scope        String
  responseBody String
  statusCode   Int
  createdAt    DateTime @default(now())
}
