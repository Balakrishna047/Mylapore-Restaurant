# ==========================================
# Mylapore Express - Global Environment Config
# ==========================================

# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# Security & Authentication
JWT_SECRET=mylapore_express_jwt_super_secret_dev_key_2026_xyz!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=mylapore_express_jwt_refresh_super_secret_dev_key_2026_xyz!
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=01234567890123456789012345678901 # 32-char hex/key for sensitive data at rest

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mylapore_express?schema=public

# Redis Cache & Queues (Optional in dev, required in high-scale prod)
REDIS_URL=redis://localhost:6379

# Payments (Stripe Adapter)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Salesforce Service Cloud & Agentforce (v2.7 Release 1)
SALESFORCE_ENABLED=false
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=https://your-domain.develop.my.salesforce.com
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here
SALESFORCE_RUN_AS_USER=your_integration_user@domain.com
SALESFORCE_USERNAME=admin@mylaporeexpress.demo
SALESFORCE_PASSWORD=your_salesforce_password_here
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token_here
SALESFORCE_AGENT_ID=0XxgK0000000000000
AGENTFORCE_API_ENDPOINT=https://api.salesforce.com/einstein/ai-agent/v1/agents
AGENTFORCE_API_KEY=your_agentforce_api_key_here
X_GATEWAY_AUTH=your_gateway_auth_token_here
AGENT_GATEWAY_AUTH_MODE=API_KEY
CHAT_HMAC_SECRET=your_chat_hmac_sha256_secret_key_here

# Restaurant Settings
RESTAURANT_TIMEZONE=Asia/Kolkata
RESTAURANT_NAME="Mylapore Express"
RESTAURANT_PHONE="+1 (925) 238-3736"
RESTAURANT_EMAIL="support@mylaporeexpress.com"
RESTAURANT_ADDRESS="Mylapore Tank & Temple Zone, Chennai / Bay Area Delivery Kitchen"
CURRENCY=USD
DEFAULT_TAX_RATE=0.0825 # 8.25% default tax
DEFAULT_DELIVERY_FEE=4.99
FREE_DELIVERY_THRESHOLD=45.00
MINIMUM_ORDER_VALUE=15.00
