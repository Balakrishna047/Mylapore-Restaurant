# ==========================================
# Mylapore Express - Global Environment Config
# ==========================================

# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# Security & Authentication
JWT_SECRET=mylapore_express_jwt_super_secret_dev_key_2026_xyz!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=mylapore_express_jwt_refresh_super_secret_dev_key_2026_xyz!
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=01234567890123456789012345678901 # 32-char hex/key for sensitive data at rest

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mylapore_express?schema=public

# Redis Cache & Queues (Optional in dev, required in high-scale prod)
REDIS_URL=redis://localhost:6379

# Payments (Stripe Adapter)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Salesforce Service Cloud & Agentforce
SALESFORCE_ENABLED=false
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=mock_salesforce_client_id
SALESFORCE_CLIENT_SECRET=mock_salesforce_client_secret
SALESFORCE_USERNAME=admin@mylaporeexpress.demo
SALESFORCE_PASSWORD=mock_password
SALESFORCE_SECURITY_TOKEN=mock_token
AGENTFORCE_API_ENDPOINT=https://api.salesforce.com/einstein/ai-agent/v1/agents

# Restaurant Settings
RESTAURANT_TIMEZONE=Asia/Kolkata
RESTAURANT_NAME="Mylapore Express"
RESTAURANT_PHONE="+1 (925) 238-3736"
RESTAURANT_EMAIL="support@mylaporeexpress.com"
RESTAURANT_ADDRESS="Mylapore Tank & Temple Zone, Chennai / Bay Area Delivery Kitchen"
CURRENCY=USD
DEFAULT_TAX_RATE=0.0825 # 8.25% default tax
DEFAULT_DELIVERY_FEE=4.99
FREE_DELIVERY_THRESHOLD=45.00
MINIMUM_ORDER_VALUE=15.00
